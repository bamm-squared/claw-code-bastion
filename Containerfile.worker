ARG CLAW_VERSION=0.1.0-rc.2
ARG CLAW_SOURCE_REVISION=unknown
FROM docker.io/library/rust:bookworm AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git libssl-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY rust /build/rust
RUN cargo build --manifest-path /build/rust/Cargo.toml --release -p execution-worker \
    && install -D /build/rust/target/release/claw-exec-worker /usr/local/bin/claw-exec-worker

FROM docker.io/library/debian:bookworm-slim
ARG CLAW_VERSION=0.1.0-rc.2
ARG CLAW_SOURCE_REVISION=unknown
LABEL org.opencontainers.image.title="Claw Code Bastion isolated runtime" \
      org.opencontainers.image.version="$CLAW_VERSION" \
      org.opencontainers.image.revision="$CLAW_SOURCE_REVISION" \
      org.opencontainers.image.source="https://github.com/bamm-squared/claw-code-bastion"
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
COPY --from=0 /usr/local/bin/claw-exec-worker /usr/local/bin/claw-exec-worker
WORKDIR /workspace/project
ENTRYPOINT ["/usr/local/bin/claw-exec-worker"]
