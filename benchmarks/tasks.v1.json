  {"id":"config-threading","version":1,"category":"multi-file","language":"rust","prompt":"Increase LIMIT from 4 to 8. Update the behavior and tests accordingly, while preserving rejection of values above LIMIT and avoiding unrelated changes.","fixture":{"files":{"Cargo.toml":"[package]\nname = \"claw_acceptance_fixture\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\npath = \"src/lib.rs\"\n","src/lib.rs":"pub mod config;\n","src/config.rs":"pub const LIMIT: usize = 4;\n\npub fn accepts(value: usize) -> bool {\n    value <= LIMIT\n}\n","tests/config.rs":"use claw_acceptance_fixture::config::{accepts, LIMIT};\n\n#[test]\nfn limit_is_four() {\n    assert_eq!(LIMIT, 4);\n}\n\n#[test]\nfn accepts_values_at_or_below_limit() {\n    assert!(accepts(4));\n}\n\n#[test]\nfn rejects_values_above_limit() {\n    assert!(!accepts(5));\n}\n"},"mock_actions":[{"kind":"write","path":"src/config.rs","content":"pub const LIMIT: usize = 8;\n\npub fn accepts(value: usize) -> bool {\n    value <= LIMIT\n}\n"},{"kind":"write","path":"tests/config.rs","content":"use claw_acceptance_fixture::config::{accepts, LIMIT};\n\n#[test]\nfn limit_is_eight() {\n    assert_eq!(LIMIT, 8);\n}\n\n#[test]\nfn accepts_values_at_or_below_limit() {\n    assert!(accepts(8));\n}\n\n#[test]\nfn rejects_values_above_limit() {\n    assert!(!accepts(9));\n}\n"}]},"hidden_oracle":{"expected_files":{"Cargo.toml":"[package]\nname = \"claw_acceptance_fixture\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\npath = \"src/lib.rs\"\n","src/lib.rs":"pub mod config;\n","src/config.rs":"pub const LIMIT: usize = 8;\n\npub fn accepts(value: usize) -> bool {\n    value <= LIMIT\n}\n","tests/config.rs":"use claw_acceptance_fixture::config::{accepts, LIMIT};\n\n#[test]\nfn limit_is_eight() {\n    assert_eq!(LIMIT, 8);\n}\n\n#[test]\nfn accepts_values_at_or_below_limit() {\n    assert!(accepts(8));\n}\n\n#[test]\nfn rejects_values_above_limit() {\n    assert!(!accepts(9));\n}\n"}},"forbidden_paths":["hidden.txt"],"expected